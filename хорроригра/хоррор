        pygame.draw.rect(screen.surface, (100,100,100), (40+i*65, HEIGHT-60, 55, 20), 1, border_radius=4)
    
    if g.ult_cooldown > 0: screen.draw.text(f"ULT: {round(g.ult_cooldown, 1)}s", (40, 140), fontsize=30, color="red")
    if g.adrenaline_timer > 0: screen.draw.text(f"ADRENALINE: {round(g.adrenaline_timer, 1)}s", (40, 170), fontsize=24, color="orange")
    pygame.draw.rect(screen.surface, (60,60,60), (40, HEIGHT-100, 180, 12), border_radius=4)
    pygame.draw.rect(screen.surface, CLR_LIGHT_UI, (42, HEIGHT-98, 1.76*g.light, 8), border_radius=3)
    screen.draw.text(f"AMMO: {g.ammo} | ROOM: {g.rooms}", (40, 40), fontsize=38, color=(200,200,200), bold=True)

    pygame.draw.rect(screen.surface, (40, 40, 40), vol_slider_bg, border_radius=5)
    vol_w = int(vol_slider_bg.width * g.music_volume)
    pygame.draw.rect(screen.surface, (200, 0, 0), (vol_slider_bg.x, vol_slider_bg.y, vol_w, 10), border_radius=5)
    vol_handle.centerx = vol_slider_bg.x + vol_w
    pygame.draw.rect(screen.surface, (220, 220, 220), vol_handle, border_radius=4)
    screen.draw.text(f"VOL: {int(g.music_volume*100)}%", right=WIDTH-260, top=35, fontsize=24, color="white")

    if g.paused:
        s = Surface((WIDTH, HEIGHT), pygame.SRCALPHA); s.fill((0,0,0,200)); screen.blit(s, (0,0))
        screen.draw.text("PAUSED", center=(WIDTH//2, HEIGHT//2), fontsize=100, color="white", shadow=(2,2))
    if g.light_flash > 0:
        s = Surface((WIDTH, HEIGHT), pygame.SRCALPHA); s.fill((255,255,255,int(g.light_flash*100))); screen.blit(s, (0,0))
    if g.damage_flash > 0:
        s = Surface((WIDTH, HEIGHT), pygame.SRCALPHA); s.fill((150,0,0,int(g.damage_flash*70))); screen.blit(s, (0,0))

def update():
    if g.state != "PLAY" or g.paused:
        if g.menu_msg_t > 0: g.menu_msg_t -= 1/60
        return

    # ЛОГИКА СМЕРТИ (НОВОЕ)
    if g.is_dying:
        if g.death_anim_timer > 0:
            g.death_anim_timer -= 1/60
            g.shake = 10
            for _ in range(3):
                g.particles.append(Particle(g.pos[0], g.pos[1], (random.randint(150, 255), 0, 0), random.uniform(2, 7)))
        elif g.death_delay_timer > 0:
            g.death_delay_timer -= 1/60
        else:
            g.state = "GAMEOVER"
        return

    if g.vol_dragging:
        mx, _ = pygame.mouse.get_pos()
        rel_x = max(0, min(vol_slider_bg.width, mx - vol_slider_bg.x))
        g.music_volume = rel_x / vol_slider_bg.width
        snd_lost.set_volume(g.music_volume)

    if g.shake > 0: g.shake *= 0.9 
    mx, my = pygame.mouse.get_pos()
    g.player_angle = math.atan2(my-g.pos[1], mx-g.pos[0])
    if g.light < 100: g.light += 0.06 
    if g.damage_flash > 0: g.damage_flash -= 0.05
    if g.light_flash > 0: g.light_flash -= 0.08
    if g.dash_cooldown > 0: g.dash_cooldown -= 1/60
    if g.shoot_cooldown > 0: g.shoot_cooldown -= 1/60
    if g.shield_timer > 0: g.shield_timer -= 1/60
    if g.ult_cooldown > 0: g.ult_cooldown -= 1/60
    if g.adrenaline_timer > 0: g.adrenaline_timer -= 1/60 # Уменьшаем таймер адреналина
    
    base_move_speed = 6.8
    if g.adrenaline_timer > 0: # Адреналин активен только пока идет таймер
        base_move_speed *= 1.25
        if g.ult_cooldown > 0: g.ult_cooldown -= 1/60 

    speed = 26.0 if g.is_dashing else base_move_speed
    
    if keyboard.f:
        g.f_charging = True
    elif g.f_charging:
        g.f_charging = False
        if g.ult_cooldown <= 0:
            target_x, target_y = pygame.mouse.get_pos()
            g.ult_cooldown = 5.0 if g.adrenaline_timer > 0 else 10.0
            g.shake = 35
            for i in range(25):
                ang = (math.pi * 2 / 25) * i
                old_p = g.pos[:]
                g.pos = [target_x, target_y]
                send_bullet(ang, BULLET_MAX_DIST)
                g.pos = old_p

    if g.is_dashing:
        g.dash_time -= 1/60
        for _ in range(5): g.particles.append(Particle(g.pos[0], g.pos[1], CLR_DASH, random.uniform(1, 3)))
        if g.dash_time <= 0: g.is_dashing = False
    dx, dy = (keyboard.d-keyboard.a), (keyboard.s-keyboard.w)
    if dx != 0 or dy != 0:
        g.trail.append((g.pos[0], g.pos[1])); 
        if len(g.trail) > g.max_trail: g.trail.pop(0)
    elif g.trail: g.trail.pop(0)
    if dx or dy:
        if random.random() < 0.4: g.particles.append(Particle(g.pos[0], g.pos[1], (60, 60, 60), 0.5))
        for i, v in enumerate([dx*speed, dy*speed]):
            old = g.pos[i]; g.pos[i] += v
            if any(Rect(g.pos[0]-14, g.pos[1]-14, 28, 28).colliderect(w) for w in g.walls + (g.gates if g.robots else [])): g.pos[i] = old
    
    for lt in g.loot[:]:
        if math.hypot(lt.pos[0]-g.pos[0], lt.pos[1]-g.pos[1]) < 45:
            if lt.type == 'hp': g.hp = min(3, g.hp+1)
            else: g.ammo += 15
            for _ in range(15): g.particles.append(Particle(lt.pos[0], lt.pos[1], (150,150,150), 4))
            g.loot.remove(lt)
            
    for r in g.robots[:]:
        r.update(g.pos, g.walls, g.robots, g.gates)
        if math.hypot(r.pos[0]-g.pos[0], r.pos[1]-g.pos[1]) < (r.size + 15) and g.shield_timer <= 0:
            old_hp = g.hp
            g.hp -= 1; g.damage_flash = 1.0; g.shield_timer = 1.3; g.shake = 12 
            if old_hp > 1 and g.hp == 1: g.adrenaline_timer = 5.0 # Активация адреналина на 5 сек
            for _ in range(20): g.particles.append(Particle(g.pos[0], g.pos[1], CLR_BLOOD, 6))
            if g.hp <= 0 and not g.is_dying: 
                if g.rooms > g.best_room: g.best_room = g.rooms
                g.is_dying = True
                g.death_anim_timer = 0.8
                g.death_delay_timer = 1.0
                pygame.mixer.stop()
                snd_death.play()
                g.music_playing = False
            
    for eb in g.enemy_bullets[:]:
        eb['x']+=eb['vx']; eb['y']+=eb['vy']
        if any(w.collidepoint(eb['x'], eb['y']) for w in g.walls): g.enemy_bullets.remove(eb); continue
        if math.hypot(eb['x']-g.pos[0], eb['y']-g.pos[1]) < 22 and g.shield_timer <= 0:
            old_hp = g.hp
            g.hp -= 1; g.damage_flash = 1.0; g.shield_timer = 1.0; g.shake = 15; g.enemy_bullets.remove(eb)
            if old_hp > 1 and g.hp == 1: g.adrenaline_timer = 5.0 # Активация адреналина на 5 сек
            if g.hp <= 0 and not g.is_dying: 
                if g.rooms > g.best_room: g.best_room = g.rooms
                g.is_dying = True
                g.death_anim_timer = 0.8
                g.death_delay_timer = 1.0
                pygame.mixer.stop()
                snd_death.play()
                g.music_playing = False
            
    for b in g.bullets[:]:
        old_bx, old_by = b['x'], b['y']
        b['x'] += b['vx']
        b['y'] += b['vy']
        b['dist'] += 22

        hit_wall = None
        for w in g.walls:
            if w.collidepoint(b['x'], b['y']):
                hit_wall = w
                break
        
        if hit_wall:
            if not b['bounced']:
                b['max_d'] *= 1.5
                b['bounced'] = True
            if old_bx < hit_wall.left or old_bx > hit_wall.right:
                b['vx'] *= -1
            else:
                b['vy'] *= -1
            b['x'], b['y'] = old_bx, old_by 
            for _ in range(5): g.particles.append(Particle(b['x'], b['y'], (100,100,100), 2))

        if b['dist'] > b['max_d']:
            if b in g.bullets: g.bullets.remove(b)
            continue
            
        for r in g.robots[:]:
            if math.hypot(b['x']-r.pos[0], b['y']-r.pos[1]) < r.size+10:
                r.health -= 1
                for _ in range(10): g.particles.append(Particle(b['x'], b['y'], CLR_BLOOD, 4))
                if b in g.bullets: g.bullets.remove(b)
                if r.health <= 0:
                    for _ in range(40): g.particles.append(Particle(r.pos[0], r.pos[1], CLR_BLOOD, random.uniform(2, 8)))
                    g.loot.append(Loot(r.pos[0], r.pos[1], 'hp' if random.random() < 0.2 else 'ammo')); g.robots.remove(r)
                break

    if not g.robots and (g.pos[0]<0 or g.pos[0]>WIDTH or g.pos[1]<0 or g.pos[1]>HEIGHT): g.generate_level(True)
    for p in g.particles[:]:
        p.update()
        if p.life <= 0: g.particles.remove(p)

def on_mouse_down(pos, button):
    if vol_handle.collidepoint(pos):
        g.vol_dragging = True
        return

    if g.state == "MENU":
        if btn_new.collidepoint(pos): g.generate_level(); g.state = "PLAY"
        if btn_settings.collidepoint(pos): g.state = "SETTINGS"
        if btn_credits.collidepoint(pos): g.state = "CREDITS"
    elif g.state == "CREDITS":
        if btn_back_credits.collidepoint(pos): g.state = "MENU" # Использование исправленной кнопки
    elif g.state == "SETTINGS":
        if btn_res1.collidepoint(pos): change_resolution(1920, 1080)
        if btn_res2.collidepoint(pos): change_resolution(1680, 1050)
        if btn_res3.collidepoint(pos): change_resolution(1600, 900)
        if btn_back.collidepoint(pos): g.state = "MENU"
    elif g.state == "GAMEOVER":
        if btn_respawn.collidepoint(pos): g.generate_level(); g.state = "PLAY"
        if btn_to_menu.collidepoint(pos): g.state = "MENU"
        
def on_mouse_up(pos, button):
    g.vol_dragging = False 
    if g.state == "PLAY" and not g.paused and not g.is_dying:
        if button == mouse.LEFT and g.shoot_cooldown <= 0 and g.ammo > 0:
            mx, my = pygame.mouse.get_pos()
            if not vol_slider_bg.inflate(20, 20).collidepoint(pos):
                d = min(math.hypot(mx - g.pos[0], my - g.pos[1]), BULLET_MAX_DIST)
                g.ammo -= 1; g.shoot_cooldown = 0.25; g.shake = 3; send_bullet(g.player_angle, d)
        elif button == mouse.RIGHT and g.ult_cooldown <= 0:
            g.ult_cooldown = 5.0 if g.adrenaline_timer > 0 else 10.0; g.shake = 20
            for a in range(-3, 4): send_bullet(g.player_angle + a*0.15, BULLET_MAX_DIST)

def send_bullet(ang, max_d): 
    g.bullets.append({
        'x':g.pos[0], 'y':g.pos[1], 
        'vx':math.cos(ang)*22, 'vy':math.sin(ang)*22, 
        'dist':0, 'max_d': max_d, 
        'bounced': False
    })

def on_key_down(key):
    if key == keys.ESCAPE:
        if g.state == "PLAY": g.paused = not g.paused
        if g.state == "SETTINGS" or g.state == "CREDITS": g.state = "MENU"
    if g.paused or g.is_dying: return
    if key == keys.LCTRL and g.dash_cooldown <= 0: g.is_dashing = True; g.dash_time = 0.18; g.dash_cooldown = 1.5
    if key == keys.R and g.light >= 30:
        g.light -= 30; g.light_flash = 1.0
        for r in g.robots:
            if math.hypot(r.pos[0]-g.pos[0], r.pos[1]-g.pos[1]) < 500:
                r.slow_timer = 4.0; 
                for _ in range(25): g.particles.append(Particle(r.pos[0], r.pos[1], CLR_LIGHT_UI, 4))
    if key == keys.SPACE and g.state == "PLAY" and g.ult_cooldown <= 0:
        g.ult_cooldown = 5.0 if g.adrenaline_timer > 0 else 10.0; g.shake = 35
        for i in range(25): send_bullet((math.pi * 2 / 25) * i, BULLET_MAX_DIST)


def run_game():
    try:
        pgzrun.go()
    except Exception as e:
        print(f"Критическая ошибка: {e}")
        # Если окно упадет, эта строка не даст консоли закрыться
        import traceback
        traceback.print_exc()
        input("\nНажми Enter, чтобы выйти...")

run_game()