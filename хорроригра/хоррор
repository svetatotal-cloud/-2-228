class Robot:
    def __init__(self, x, y, level, is_boss=False):
        self.pos = [float(x), float(y)]
        self.is_boss = is_boss
        self.level = level # Сохраняем уровень для дальнейших вычислений
        
        # СИСТЕМА УСИЛЕНИЯ ВРАГОВ (СКАЛИРОВАНИЕ)
        hp_multiplier = 1.0 + (level * 0.2) # +20% ХП за каждую комнату
        speed_multiplier = 1.0 + (level * 0.05) # +5% к скорости за каждую комнату
        shoot_reduction = level * 0.05 # Ускорение стрельбы
        
        base_max_hp = (30 + level * 2) if is_boss else 3
        self.max_hp = int(base_max_hp * hp_multiplier)
        self.health = self.max_hp
        
        base_speed_val = (1.7 / 1.5) if is_boss else (random.uniform(2.5, 3.1) / 1.5)
        self.base_speed = base_speed_val * speed_multiplier
        self.speed = self.base_speed
        
        self.slow_timer = 0
        self.size = 70 if is_boss else 22
        self.angle = 0
        
        min_shoot = max(0.2, 1.0 - shoot_reduction)
        max_shoot = max(0.5, 3.0 - shoot_reduction)
        self.shoot_timer = random.uniform(min_shoot, max_shoot)
        
        self.strafe_dir = random.choice([-1, 1])
        self.ideal_dist = random.randint(200, 450) if not is_boss else 150
        self.anim_offset = random.uniform(0, math.pi * 2)

    def update(self, player_pos, walls, others, gates):
        if self.slow_timer > 0:
            self.slow_timer -= 1/60
            self.speed = self.base_speed * 0.35 
        else: 
            self.speed = self.base_speed
            
        dx, dy = player_pos[0]-self.pos[0], player_pos[1]-self.pos[1]
        dist = math.hypot(dx, dy)
        angle_to_player = math.atan2(dy, dx)

        move_angle = angle_to_player
        if dist < self.ideal_dist:
            move_angle -= 1.1 * self.strafe_dir
        elif dist > self.ideal_dist + 60:
            move_angle += 0.4 * self.strafe_dir
        
        vx, vy = math.cos(move_angle)*self.speed, math.sin(move_angle)*self.speed

        if any(Rect(self.pos[0]+vx*15-10, self.pos[1]+vy*15-10, 20, 20).colliderect(w) for w in walls):
            self.strafe_dir *= -1 

        self.shoot_timer -= 1/60
        if self.shoot_timer <= 0:
            p_vx = (keyboard.d - keyboard.a) * 6.8
            p_vy = (keyboard.s - keyboard.w) * 6.8
            target_x = player_pos[0] + p_vx * 12
            target_y = player_pos[1] + p_vy * 12
            fire_ang = math.atan2(target_y - self.pos[1], target_x - self.pos[0])
            
            g.enemy_bullets.append({'x':self.pos[0], 'y':self.pos[1], 
                                  'vx':math.cos(fire_ang)*7.5, 'vy':math.sin(fire_ang)*7.5})
            
            shoot_reduce = self.level * 0.05
            self.shoot_timer = random.uniform(max(0.2, 1.2 - shoot_reduce), max(0.5, 2.8 - shoot_reduce))

        for o in others:
            if o != self:
                d = math.hypot(self.pos[1]-o.pos[0], self.pos[1]-o.pos[1])
                if d < (self.size + o.size + 15):
                    a = math.atan2(self.pos[1]-o.pos[1], self.pos[0]-o.pos[0])
                    vx += math.cos(a)*1.2; vy += math.sin(a)*1.2

        for i, (delta) in enumerate([vx, vy]):
            old = self.pos[i]; self.pos[i] += delta
            if any(Rect(self.pos[0]-self.size, self.pos[1]-self.size, self.size*2, self.size*2).colliderect(w) for w in walls + gates):
                self.pos[i] = old

