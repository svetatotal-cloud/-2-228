        # НОВЫЕ ПЕРЕМЕННЫЕ ДЛЯ СМЕРТИ
        self.death_anim_timer = 0
        self.death_delay_timer = 0
        self.is_dying = False

    def generate_level(self, next_room=False):
        if next_room: 
            self.rooms += 1
            if self.rooms > self.best_room:
                self.best_room = self.rooms # Обновляем рекорд
        elif self.state == "MENU" or self.state == "GAMEOVER":
            if self.rooms > self.best_room:
                self.best_room = self.rooms # Сохраняем перед сбросом
            self.rooms = 1; self.hp = 3; self.ammo = 60; self.light = 100.0
            self.adrenaline_timer = 0 # Сброс адреналина
            self.is_dying = False
            self.death_anim_timer = 0
            self.death_delay_timer = 0
        
        if not self.music_playing:
            snd_lost.play(loops=-1)
            snd_lost.set_volume(self.music_volume)
            self.music_playing = True

        self.walls, self.robots, self.bullets, self.gates, self.particles, self.loot, self.enemy_bullets = [], [], [], [], [], [], []
        self.trail = []
        T, H = 45, 200
        self.walls.extend([Rect(0,0,WIDTH//2-H,T), Rect(WIDTH//2+H,0,WIDTH//2-H,T), Rect(0,HEIGHT-T,WIDTH//2-H,T), Rect(WIDTH//2+H,HEIGHT-T,WIDTH//2-H,T)])
        self.walls.extend([Rect(0,0,T,HEIGHT//2-H), Rect(0,HEIGHT//2+H,T,HEIGHT//2-H), Rect(WIDTH-T,0,T,HEIGHT//2-H), Rect(WIDTH-T,HEIGHT//2+H,T,HEIGHT//2-H)])
        self.gates.extend([Rect(WIDTH//2-H,0,H*2,T), Rect(WIDTH//2-H,HEIGHT-T,H*2,T), Rect(0,HEIGHT//2-H,T,H*2), Rect(WIDTH-T,HEIGHT//2-H,T,H*2)])
        
        safe_dist = 180 
        for _ in range(12):
            w = Rect(random.randint(250, WIDTH-350), random.randint(200, HEIGHT-300), 90, 90)
            too_close = any(w.inflate(safe_dist, safe_dist).colliderect(other) for other in self.walls)
            if not too_close and not w.inflate(200, 200).colliderect(Rect(WIDTH//2, HEIGHT//2, 1, 1)):
                self.walls.append(w)

        if self.rooms % 5 == 0: self.robots.append(Robot(WIDTH-200, HEIGHT//2, self.rooms, True))
        else:
            for _ in range(5 + self.rooms // 2):
                self.robots.append(Robot(random.choice([150, WIDTH-150]), random.choice([150, HEIGHT-150]), self.rooms))
        self.pos = [WIDTH//2, HEIGHT//2]; self.shield_timer = 1.0

