class Particle:
    def __init__(self, x, y, color, speed=None, decay=0.04):
        self.x, self.y = x, y
        self.color = color
        ang = random.uniform(0, math.pi * 2)
        s = speed if speed is not None else random.uniform(2, 5)
        self.vx, self.vy = math.cos(ang) * s, math.sin(ang) * s
        self.life = 1.0
        self.size = random.randint(2, 5)
        self.decay = decay
        
    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.life -= self.decay
        self.size *= 0.94

