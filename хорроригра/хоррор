def get_aim_ricochet(start, end, walls):
    dx, dy = end[0] - start[0], end[1] - start[1]
    dist = math.hypot(dx, dy)
    if dist == 0: return None
    
    steps = int(dist)
    hit_point = None
    hit_wall = None
    
    for i in range(0, steps, 2):
        px = start[0] + (dx * i / steps)
        py = start[1] + (dy * i / steps)
        for w in walls:
            if w.collidepoint(px, py):
                hit_point = (px, py)
                hit_wall = w
                break
        if hit_point: break
        
    if hit_point and hit_wall:
        rx, ry = dx, dy
        if hit_point[0] <= hit_wall.left + 5 or hit_point[0] >= hit_wall.right - 5:
            rx *= -1
        else:
            ry *= -1
            
        remaining = (BULLET_MAX_DIST * 1.5) - math.hypot(hit_point[0]-start[0], hit_point[1]-start[1])
        mag = math.hypot(rx, ry)
        if mag > 0:
            rx, ry = (rx/mag)*remaining, (ry/mag)*remaining
            
        reflect_end = (hit_point[0] + rx, hit_point[1] + ry)
        return hit_point, reflect_end
    return None

